# =============================================================================
# SlotWise — Environment Variables
# =============================================================================
# Copy this file to `.env` and adjust values as needed.
# Default values below work out of the box with docker-compose.
# =============================================================================

# ---- PostgreSQL Database ----
POSTGRES_USER=slotwise
POSTGRES_PASSWORD=slotwise_secret
POSTGRES_DB=slotwise_db
POSTGRES_PORT=5433

# ---- Spring Boot Backend ----
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/slotwise_db
SPRING_DATASOURCE_USERNAME=slotwise
SPRING_DATASOURCE_PASSWORD=slotwise_secret

# JWT Configuration
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1

